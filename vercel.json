{
  "_comment": "If Vercel Hobby limits to daily, use Upstash QStash or cron-job.org with Bearer CRON_SECRET header.",
  "crons": [
    {
      "path": "/api/cron/schedule",
      "schedule": "2-59/5 * * * *"
    },
    {
      "path": "/api/linkedin/publish-scheduled",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/linkedin/sync-analytics",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/process-queue",
      "schedule": "4-59/5 * * * *"
    },
    {
      "path": "/api/cron/cleanup-pdfs",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/check-expiry",
      "schedule": "0 0 * * *"
    }
  ]
}
