# Vite exposes only variables prefixed with VITE_ to the browser.
# Copy to .env.local and fill in values. Restart `npm run dev` after changes.

# --- Clerk (required for auth) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Server-only (Next.js / API routes / webhooks — never VITE_ prefix):
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=

# --- Groq (required for AI Writer / voice features in this SPA) ---
# Never commit production keys; prefer a backend proxy for production.
VITE_GROQ_API_KEY=
# Optional override:
# VITE_GROQ_MODEL=llama-3.3-70b-versatile

# --- Supabase (syncs workspace across devices; optional) ---
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=
# Create a JWT template named "supabase" in Clerk (Third-party auth). Override name if needed:
# VITE_CLERK_JWT_TEMPLATE=supabase
# Run supabase/user_workspace.sql in the SQL editor, then enable Clerk ↔ Supabase per Supabase docs.

# Postgres URLs are for Prisma/server runtimes — not for Vite import.meta.env:
# DATABASE_URL=postgresql://...pooler...
# DIRECT_URL=postgresql://postgres:PASSWORD@db....supabase.co:5432/postgres

# --- Public site URLs ---
VITE_PUBLIC_MARKETING_URL=https://www.byqalam.com
VITE_PUBLIC_APP_URL=https://app.byqalam.com
VITE_PUBLIC_APP_SUBDOMAIN_URL=https://app.byqalam.com

# Comma-separated; matching Clerk primary emails get admin hints (e.g. 404 tooling).
VITE_APP_ADMIN_EMAILS=info@byqalam.com

# Optional legacy params (replaces old Base44 app id):
# VITE_APP_ID=

# --- Support / billing (optional; use in UI when you read from import.meta.env) ---
# VITE_APP_SUPPORT_EMAIL=info@byqalam.com
# VITE_APP_SUPPORT_WHATSAPP=+923188547351
# VITE_APP_BANK_DETAILS=
