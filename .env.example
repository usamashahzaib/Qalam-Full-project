# NEVER commit real .env files. This repo is public.
# If you accidentally commit .env with real keys, rotate them immediately.
# Copy this file to .env.local and fill in your values.
#
# Each section below is labeled with what happens if it's left unset:
#   [BOOT-REQUIRED]     the app fails to start / that route throws on every request
#   [DEGRADES A FEATURE] the app still runs, only that one feature is disabled
#   [BUILD-TIME ONLY]    only needed in CI/Vercel build env, never at runtime

# ─── Supabase [BOOT-REQUIRED] ────────────────────────────────────────────────
# Find these in Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# For running migrations via scripts/run-migrations.mjs:
# Get SUPABASE_ACCESS_TOKEN from: https://app.supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...
# OR connect directly (Dashboard > Settings > Database > Connection pooling):
# SUPABASE_DB_URL=postgresql://postgres.your-project:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Set this to 1 in the production build environment. The build then fails if
# any tracked Supabase migration has not been applied.
REQUIRE_MIGRATION_CHECK=0

# ─── Auth [BOOT-REQUIRED] ────────────────────────────────────────────────────
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here
# Optional dedicated secret for seven-day extension tokens. Defaults to
# AUTH_SECRET when unset, but set a distinct value to rotate extension access independently.
EXTENSION_TOKEN_SECRET=your-extension-token-secret-here
# Read directly by the next-auth package itself (not via lib/server/env.ts) as
# the canonical callback/redirect URL. Usually inferable from request headers
# on Vercel, but set it explicitly for other hosts or local HTTPS testing.
NEXTAUTH_URL=https://app.byqalam.com
# Generate CRON_SECRET with: openssl rand -hex 32 - must match Vercel dashboard
CRON_SECRET=your-cron-secret-here

# ─── LinkedIn OAuth [BOOT-REQUIRED for auth; connect flow needs the encryption key] ─
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
# LinkedIn API version (defaults to 202602 if unset)
LINKEDIN_VERSION=202602
# 64-char hex (32-byte) key used to encrypt stored LinkedIn tokens (AES-256-GCM). Required - connect flow fails without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINKEDIN_TOKEN_ENCRYPTION_KEY=your-64-char-hex-key

# ─── AI Providers [BOOT-REQUIRED: at least one key; more = better fallback coverage] ─
# Groq - https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Gemini - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
# Mistral - https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=...
# Cerebras - https://cloud.cerebras.ai/
CEREBRAS_API_KEY=csk-...
# OpenRouter (free-tier fallback) - https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# [DEGRADES A FEATURE] Global daily spend ceiling across all users/providers,
# checked before every AI dispatch. Unset/0 = no cap enforced (current
# behavior). Warns at 80% of the ceiling, refuses new AI calls at 100%.
AI_DAILY_SPEND_CAP_USD=50

# ─── Redis / Upstash [BOOT-REQUIRED - app will block AI generation without this] ──
# Used for rate limiting and queues. Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
# Shared daily ceiling on unauthenticated free-tools AI calls across all IPs
# combined (see lib/server/rate-limit.ts checkFreeToolsGlobalBudget).
FREE_TOOLS_DAILY_CAP=2000
# Per-instance fallback ceiling used only while Redis is unreachable - kept
# low and deliberately not a proportional share of FREE_TOOLS_DAILY_CAP, since
# multiple concurrent instances each get their own counter.
FREE_TOOLS_FALLBACK_DAILY_CAP=100

# ─── QStash [DEGRADES A FEATURE] ─────────────────────────────────────────────
# Schedules exact-time LinkedIn auto-publish callbacks. Unset = scheduled
# posts still publish, just via the daily safety-net cron (up to ~24h delay).
# Get from: https://console.upstash.com (QStash tab)
QSTASH_TOKEN=...
QSTASH_CURRENT_SIGNING_KEY=...
QSTASH_NEXT_SIGNING_KEY=...

# ─── Payments [DEGRADES A FEATURE per provider] ──────────────────────────────
# STRIPE_WEBHOOK_SECRET: from Stripe Dashboard > Webhooks > signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
JAZZCASH_WEBHOOK_SECRET=...
EASYPAISA_WEBHOOK_SECRET=...
# Lemon Squeezy Dashboard > Settings > Webhooks > signing secret. Webhook URL: /api/payments/webhook
LEMONSQUEEZY_WEBHOOK_SECRET=...
# Lemon Squeezy Dashboard > Settings > API - only needed for server-side checkout/subscription management
LEMONSQUEEZY_API_KEY=...
# Quarterly subscription variants. Create each variant with a 3-month renewal interval.
NEXT_PUBLIC_LEMONSQUEEZY_SOLO_QUARTERLY_URL=https://byqalam.lemonsqueezy.com/checkout/buy/...
NEXT_PUBLIC_LEMONSQUEEZY_PRO_QUARTERLY_URL=https://byqalam.lemonsqueezy.com/checkout/buy/...
LEMONSQUEEZY_SOLO_QUARTERLY_VARIANT_ID=...
LEMONSQUEEZY_PRO_QUARTERLY_VARIANT_ID=...
# Career add-ons require one published, one-time PKR variant per software credit.
NEXT_PUBLIC_CAREER_ADDON_CHECKOUT_LIVE=false
# Set to true only after every private Lemon Squeezy career add-on variant ID is configured.
NEXT_PUBLIC_CAREER_ADDON_CHECKOUT_READY=false
LEMONSQUEEZY_CAREER_ADDON_EXTRA_RESUME_VARIANT_ID=...
LEMONSQUEEZY_CAREER_ADDON_COVER_LETTER_VARIANT_ID=...
LEMONSQUEEZY_CAREER_ADDON_INTERVIEW_PACK_VARIANT_ID=...
LEMONSQUEEZY_CAREER_ADDON_RECRUITER_REVIEW_VARIANT_ID=...
LEMONSQUEEZY_CAREER_ADDON_LINKEDIN_REWRITE_VARIANT_ID=...
LEMONSQUEEZY_CAREER_ADDON_CAREER_BLUEPRINT_VARIANT_ID=...
LEMONSQUEEZY_CAREER_PACK_APPLICATION_VARIANT_ID=...
LEMONSQUEEZY_CAREER_PACK_JOB_WIN_VARIANT_ID=...
LEMONSQUEEZY_CAREER_PACK_CAREER_RESET_VARIANT_ID=...
LEMONSQUEEZY_CAREER_PACK_EXECUTIVE_RESET_VARIANT_ID=...

# ─── Email [DEGRADES A FEATURE - transactional email silently no-ops] ───────
# Get RESEND_API_KEY from: https://resend.com/api-keys
RESEND_API_KEY=re_...
TRANSACTIONAL_EMAIL_FROM=Qalam <noreply@yourdomain.com>

# ─── Admin [DEGRADES A FEATURE - admin routes 404 without these] ────────────
# Comma-separated list of admin email addresses (used by /admin panel and all
# app/api/admin/* routes)
APP_ADMIN_EMAILS=admin@example.com
# Secret key required in the x-admin-key header for the header-gated
# app/api/admin/* ops routes (see lib/server/workspace.ts requireAdminOps)
# Generate with: openssl rand -hex 32
ADMIN_SECRET_KEY=your-admin-secret-key-here

# ─── App URLs [BOOT-REQUIRED] ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://byqalam.com
NEXT_PUBLIC_MARKETING_URL=https://byqalam.com
NEXT_PUBLIC_APP_URL=https://byqalam.com
FRONTEND_ORIGIN=https://byqalam.com
# Optional ownership verification tokens from Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ─── Analytics [OPTIONAL] ────────────────────────────────────────────────────
# GA4 measurement ID from your own property (Admin > Data Streams > Web).
# There is no fallback: leave this unset and no analytics tag is rendered at all.
# The tag renders only for an explicitly recognized deployment tier. These are
# NEXT_PUBLIC_ vars, so changing them requires a redeploy, not just an env edit.
# Never paste an ID you have not confirmed belongs to the intended property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional. A separate GA4 property for preview deployments so preview traffic
# never contaminates the production baseline. Leave unset to keep preview silent.
NEXT_PUBLIC_GA_PREVIEW_MEASUREMENT_ID=
# Optional override for off-Vercel hosts. On Vercel this is derived from
# NEXT_PUBLIC_VERCEL_ENV automatically. Values: production, preview, development.
NEXT_PUBLIC_QALAM_ENV=
# Set to 1 in preview release validation to fail if the preview GA ID is missing.
STRICT_ANALYTICS_READINESS=0

# IndexNow [DEGRADES A FEATURE - sitemap remains available without it]
# Generate 8 to 128 ASCII letters, numbers, or hyphens. Keep the production value stable.
INDEXNOW_KEY=replace-with-a-stable-indexnow-key

# ─── Networking [DEGRADES A FEATURE - IP-based rate limits weaken without it] ─
# Set to "cloudflare" only if Cloudflare (or another edge proxy that strips
# inbound cf-connecting-ip/x-real-ip from clients before setting its own) sits
# in front of this deployment. Leave unset on plain Vercel - those headers are
# otherwise client-controlled and rate limiting instead falls back to
# x-vercel-forwarded-for / x-forwarded-for.
TRUSTED_EDGE_PROXY=

# ─── Support [DEGRADES A FEATURE - falls back to hardcoded defaults] ─────────
APP_SUPPORT_EMAIL=info@byqalam.com
APP_SUPPORT_WHATSAPP=+923001234567
NEXT_PUBLIC_SUPPORT_WHATSAPP=+923001234567

# ─── Sentry (error tracking) [DEGRADES A FEATURE - errors just aren't reported] ─
# DSN from Sentry Dashboard > Settings > Projects > [project] > Client Keys (DSN)
# DSN values are public by design (safe in client bundles) - not a secret.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# [BUILD-TIME ONLY] Only needed to upload source maps (CI/Vercel build env)
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=sntrys_...
