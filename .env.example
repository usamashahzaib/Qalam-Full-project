# NEVER commit real .env files. This repo is public.
# If you accidentally commit .env with real keys, rotate them immediately.
# Copy this file to .env.local and fill in your values.

# ─── Supabase (Required) ────────────────────────────────────────────────────
# Find these in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ─── Auth (Required) ────────────────────────────────────────────────────────
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here
NEXTAUTH_URL=https://byqalam.com
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# Google OAuth (optional — enables "Continue with Google" on login/signup)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── AI Providers (Required - at least one) ─────────────────────────────────
# Get GROQ_API_KEY from: https://console.groq.com/keys
# Get GEMINI_API_KEY from: https://aistudio.google.com/app/apikey
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...

# ─── Redis (Optional but recommended for production) ────────────────────────
# Used for rate limiting and queues. Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ─── Payments (For future use) ──────────────────────────────────────────────
# STRIPE_WEBHOOK_SECRET: from Stripe Dashboard > Webhooks > signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
JAZZCASH_WEBHOOK_SECRET=...
EASYPAISA_WEBHOOK_SECRET=...

# ─── Email (Optional) ───────────────────────────────────────────────────────
# Get RESEND_API_KEY from: https://resend.com/api-keys
RESEND_API_KEY=re_...
TRANSACTIONAL_EMAIL_FROM=Qalam <noreply@yourdomain.com>

# ─── Admin ──────────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses (used by /admin panel)
ADMIN_EMAILS=admin@example.com
APP_ADMIN_EMAILS=admin@example.com
# Secret key required in x-admin-key header for all admin API requests
# Generate with: openssl rand -hex 32
ADMIN_SECRET_KEY=your-admin-secret-key-here

# ─── App URLs ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://byqalam.com
NEXT_PUBLIC_APP_URL=https://byqalam.com
FRONTEND_ORIGIN=https://byqalam.com

# ─── Support ────────────────────────────────────────────────────────────────
APP_SUPPORT_EMAIL=support@byqalam.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=+923001234567

# ─── LinkedIn API ───────────────────────────────────────────────────────────
# LinkedIn API version (defaults to 202602 if unset)
LINKEDIN_VERSION=202602
