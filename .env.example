# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project REST API URL — find in Supabase dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — server-side only, NEVER expose to the browser
# Supabase dashboard > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon key — safe to expose, restricted by RLS
# Supabase dashboard > Settings > API > anon (public)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Session signing secret ────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=generate-a-64-char-hex-string-here

# ─── Cron secret ──────────────────────────────────────────────────────────────
# Must match exactly what you set in Vercel dashboard > Environment Variables
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=generate-a-64-char-hex-string-here

# ─── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated list of emails that get role: "admin" in sessions
APP_ADMIN_EMAILS=info@byqalam.com

# ─── App URLs ─────────────────────────────────────────────────────────────────
# Local dev: http://localhost:3000
# Production: https://www.byqalam.com
NEXT_PUBLIC_SITE_URL=https://www.byqalam.com
NEXT_PUBLIC_MARKETING_URL=https://www.byqalam.com
NEXT_PUBLIC_APP_URL=https://www.byqalam.com
FRONTEND_ORIGIN=https://www.byqalam.com

# ─── LinkedIn OAuth ────────────────────────────────────────────────────────────
# Create/manage your app at: https://www.linkedin.com/developers/apps
# Add LINKEDIN_REDIRECT_URI to "Authorized redirect URLs" in the LinkedIn app
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# Local: http://localhost:3000/api/linkedin/callback
# Production: https://www.byqalam.com/api/linkedin/callback
LINKEDIN_REDIRECT_URI=https://www.byqalam.com/api/linkedin/callback

# LinkedIn API version (YYYYMM format)
LINKEDIN_VERSION=202602

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key-here

# ─── Support channels ─────────────────────────────────────────────────────────
APP_SUPPORT_EMAIL=info@byqalam.com
APP_SUPPORT_WHATSAPP=+923714156567

# ─── SEO Verification ─────────────────────────────────────────────────────────
# Google Search Console: search.google.com/search-console → Add property →
#   HTML tag method → copy the content="" value only (not the full tag)
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster: bing.com/webmasters → Add site → HTML meta tag method →
#   copy the content="" value only
# Also replace the placeholder in public/BingSiteAuth.xml with the same code
BING_SITE_VERIFICATION=
