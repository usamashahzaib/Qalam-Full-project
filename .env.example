# Required: Supabase. Find values in Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Required: Auth. Generate AUTH_SECRET with:
# openssl rand -base64 32
AUTH_SECRET=your-strong-random-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Required: AI. Add at least one provider key.
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Optional: Redis. Recommended for queues and stronger rate limiting.
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Future payments. Keep secrets server-side only.
STRIPE_WEBHOOK_SECRET=whsec_placeholder
JAZZCASH_WEBHOOK_SECRET=your-jazzcash-webhook-secret
EASYPAISA_WEBHOOK_SECRET=your-easypaisa-webhook-secret

# Optional: Email.
RESEND_API_KEY=your-resend-api-key
TRANSACTIONAL_EMAIL_FROM=Qalam <noreply@example.com>

# Admin. Comma-separated emails.
APP_ADMIN_EMAILS=admin@example.com,founder@example.com
ADMIN_API_KEY=your-admin-api-key

# App URLs.
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_APP_URL=https://www.example.com
FRONTEND_ORIGIN=https://www.example.com

# Support.
APP_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=+920000000000

# Optional LinkedIn API version.
LINKEDIN_VERSION=202602

# Never commit real service role keys, OAuth secrets, API keys, webhook secrets, or admin keys.
