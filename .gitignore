# Campaign archives are regenerable build output from render-posters.mjs and run
# to tens of MB each. Committing them would pin that weight into git history
# permanently, so keep the source folders and leave the zips out.
linkedin posting/campaigns/*.zip
tsconfig.tsbuildinfo
dev-server.log
next-dev-*.log
next-start-*.log

# Backup files
*.bak
*.old
*.backup

# Machine-specific AI tool configs
.abacusai/
.claude/settings.local.json
