{
  "name": "byqalam-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "prebuild": "node scripts/check-career-addon-readiness.mjs && node scripts/check-migrations-applied.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:dashes": "node scripts/check-no-dashes.mjs",
    "check:rls": "node scripts/check-rls.mjs",
    "check:career-addons": "node scripts/check-career-addon-readiness.mjs",
    "check:analytics": "node scripts/check-analytics-readiness.mjs",
    "check:migrations": "node scripts/check-migrations-applied.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.67.0",
    "@supabase/supabase-js": "^2.87.1",
    "@upstash/qstash": "^2.11.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "argon2": "^0.44.0",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "sharp": "^0.35.3",
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-unused-imports": "^4.4.1",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
